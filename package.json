{
  "name": "cat-break-desktop",
  "version": "1.0.9",
  "description": "Eye break reminders with fullscreen overlay and cat mascot (macOS, Windows, Linux)",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node scripts/selfcheck-lib.js && node scripts/version.js check",
    "version:check": "node scripts/version.js check",
    "bump:patch": "node scripts/version.js bump patch",
    "bump:minor": "node scripts/version.js bump minor",
    "bump:major": "node scripts/version.js bump major",
    "smoke": "electron scripts/smoke-electron.js",
    "sync:assets": "node scripts/sync-release-assets.js",
    "prepare": "node scripts/sync-release-assets.js && node scripts/prepare-icons.js",
    "pack": "npm run prepare && electron-builder --dir",
    "dist": "npm run dist:mac",
    "dist:mac": "npm run prepare && electron-builder --mac && cp docs/en/MACOS_INSTALL.md dist/",
    "dist:mac:x64": "npm run prepare && electron-builder --mac --x64 && cp docs/en/MACOS_INSTALL.md dist/",
    "dist:win": "npm run prepare && electron-builder --win",
    "dist:linux": "npm run prepare && electron-builder --linux",
    "dist:all": "npm run prepare && electron-builder -mwl"
  },
  "author": "Anatoly Kulishov <anatoly-kulishov@users.noreply.github.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/anatoly-kulishov/CatBreak.git"
  },
  "keywords": [
    "electron",
    "break-reminder",
    "eye-health",
    "pomodoro",
    "macos",
    "windows",
    "linux"
  ],
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "electron-updater": "^6.8.3"
  },
  "devDependencies": {
    "electron": "^35.0.0",
    "electron-builder": "^25.1.8",
    "png-to-ico": "^2.1.8",
    "sharp": "^0.34.5"
  },
  "build": {
    "appId": "com.catbreak.desktop",
    "productName": "Cat Break",
    "artifactName": "Cat-Break-${version}-${arch}.${ext}",
    "files": [
      "main.js",
      "preload-*.js",
      "lib/**/*",
      "locales/**/*",
      "src/**/*",
      "assets/**/*",
      "build/icon.icns",
      "build/icon.ico",
      "build/icon.png"
    ],
    "mac": {
      "category": "public.app-category.healthcare-fitness",
      "icon": "build/icon.icns",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "dmg": {
      "title": "${productName} ${version}",
      "iconSize": 80,
      "window": {
        "width": 540,
        "height": 420
      },
      "contents": [
        {
          "x": 140,
          "y": 150
        },
        {
          "x": 400,
          "y": 150,
          "type": "link",
          "path": "/Applications"
        },
        {
          "x": 270,
          "y": 340,
          "type": "file",
          "path": "docs/mac/HOW_TO_OPEN.txt",
          "name": "Как открыть.txt"
        }
      ]
    },
    "win": {
      "icon": "build/icon.ico",
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "nsis",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerLanguages": [
        "ru",
        "en"
      ]
    },
    "linux": {
      "icon": "build/icon.png",
      "category": "Utility",
      "maintainer": "Anatoly Kulishov <anatoly-kulishov@users.noreply.github.com>",
      "target": [
        "AppImage",
        "deb"
      ],
      "desktop": {
        "Name": "Cat Break",
        "Comment": "Break reminders for your eyes",
        "Categories": "Utility;"
      }
    },
    "publish": {
      "provider": "github",
      "owner": "anatoly-kulishov",
      "repo": "CatBreak",
      "releaseType": "release",
      "timeout": 1800000
    }
  }
}
